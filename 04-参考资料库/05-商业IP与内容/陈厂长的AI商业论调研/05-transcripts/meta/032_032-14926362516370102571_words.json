{
  "segments": [
    {
      "start": 0.0,
      "end": 0.9,
      "text": "相亲一个失败一个"
    },
    {
      "start": 0.9,
      "end": 1.74,
      "text": "相亲一个失败一个"
    },
    {
      "start": 1.74,
      "end": 2.8,
      "text": "那AI怎么搞的"
    },
    {
      "start": 2.8,
      "end": 4.12,
      "text": "我说你把提示词发给我看一下"
    },
    {
      "start": 4.12,
      "end": 5.26,
      "text": "我在里面加了一句话"
    },
    {
      "start": 5.26,
      "end": 6.94,
      "text": "我说此人长得很丑"
    },
    {
      "start": 6.94,
      "end": 8.98,
      "text": "回去之后马上出来的策略就不一样"
    },
    {
      "start": 8.98,
      "end": 10.78,
      "text": "小伙子之前在我们这家上课"
    },
    {
      "start": 10.78,
      "end": 12.12,
      "text": "回去做了个相亲智能系"
    },
    {
      "start": 12.12,
      "end": 13.22,
      "text": "他想找对象"
    },
    {
      "start": 13.22,
      "end": 14.12,
      "text": "他回来跟我说"
    },
    {
      "start": 14.12,
      "end": 15.24,
      "text": "他说AI不行"
    },
    {
      "start": 15.24,
      "end": 16.38,
      "text": "水平一般呢"
    },
    {
      "start": 16.38,
      "end": 18.7,
      "text": "就是他长得像王宝强"
    },
    {
      "start": 18.7,
      "end": 20.84,
      "text": "但是在他心目中搞不好"
    },
    {
      "start": 20.84,
      "end": 21.8,
      "text": "他长得像金城武"
    },
    {
      "start": 21.8,
      "end": 24.12,
      "text": "他AI按照金城武的标准给他"
    },
    {
      "start": 24.12,
      "end": 24.86,
      "text": "出的相亲策略"
    },
    {
      "start": 24.86,
      "end": 26.4,
      "text": "在王宝强身上能有用吗"
    },
    {
      "start": 26.4,
      "end": 27.26,
      "text": "那理解这事吧"
    },
    {
      "start": 27.26,
      "end": 28.42,
      "text": "这是很残忍的一个事情"
    },
    {
      "start": 28.42,
      "end": 30.88,
      "text": "就是人一般不愿意聊自己弱点"
    },
    {
      "start": 30.88,
      "end": 31.8,
      "text": "不讲自己弱点"
    },
    {
      "start": 31.8,
      "end": 33.18,
      "text": "我个人反正是推崇的"
    },
    {
      "start": 33.18,
      "end": 34.18,
      "text": "叫做极致的自成"
    },
    {
      "start": 34.18,
      "end": 35.48,
      "text": "我在用AI的过程中"
    },
    {
      "start": 35.48,
      "end": 37.26,
      "text": "我大量的向他暴露我的缺点"
    },
    {
      "start": 37.26,
      "end": 38.54,
      "text": "包括公司的缺点"
    },
    {
      "start": 38.54,
      "end": 40.02,
      "text": "公司组织上的限制"
    },
    {
      "start": 40.02,
      "end": 41.38,
      "text": "资金规模上的限制"
    },
    {
      "start": 41.38,
      "end": 42.32,
      "text": "人数上的限制"
    },
    {
      "start": 42.32,
      "end": 43.08,
      "text": "能力上的限制"
    },
    {
      "start": 43.08,
      "end": 44.26,
      "text": "时间周期上的限制"
    },
    {
      "start": 44.26,
      "end": 44.48,
      "text": "对吧"
    },
    {
      "start": 44.48,
      "end": 45.78,
      "text": "包括我个人能力上的限制"
    },
    {
      "start": 45.78,
      "end": 46.82,
      "text": "性格上的限制"
    },
    {
      "start": 46.82,
      "end": 47.96,
      "text": "我都是在这个背景中"
    },
    {
      "start": 47.96,
      "end": 48.82,
      "text": "同步的清清楚楚"
    },
    {
      "start": 48.82,
      "end": 49.94,
      "text": "必须让他能够知道"
    },
    {
      "start": 49.94,
      "end": 50.9,
      "text": "那基于这个东西"
    },
    {
      "start": 50.9,
      "end": 51.82,
      "text": "他给你做出来的方案"
    },
    {
      "start": 51.82,
      "end": 52.62,
      "text": "是真正的"
    },
    {
      "start": 52.62,
      "end": 53.22,
      "text": "靠谱的"
    },
    {
      "start": 53.22,
      "end": 53.74,
      "text": "落地的"
    },
    {
      "start": 53.74,
      "end": 55.04,
      "text": "能有一定带来价值的"
    },
    {
      "start": 55.04,
      "end": 56.22,
      "text": "如果你想了解更多"
    },
    {
      "start": 56.22,
      "end": 57.18,
      "text": "AI的高级用法"
    },
    {
      "start": 57.18,
      "end": 58.1,
      "text": "评论区留言"
    },
    {
      "start": 58.54,
      "end": 58.84,
      "text": "AI"
    },
    {
      "start": 58.84,
      "end": 60.04,
      "text": "我送你一份文道"
    }
  ],

{
  "segments": [
    {
      "start": 0.0,
      "end": 2.0,
      "text": "如果AI给你一个答案你不满意"
    },
    {
      "start": 2.0,
      "end": 3.54,
      "text": "不要给他任何意见"
    },
    {
      "start": 3.54,
      "end": 4.48,
      "text": "连意见都不要给"
    },
    {
      "start": 4.48,
      "end": 6.36,
      "text": "AI给我们做的事不符合我们需求"
    },
    {
      "start": 6.36,
      "end": 7.52,
      "text": "你要怎么调试AI"
    },
    {
      "start": 7.52,
      "end": 9.36,
      "text": "教你一招最好的招"
    },
    {
      "start": 9.72,
      "end": 10.76,
      "text": "所有人都学过"
    },
    {
      "start": 10.76,
      "end": 11.82,
      "text": "所有人都听过这句话"
    },
    {
      "start": 11.82,
      "end": 12.82,
      "text": "教你错了吗"
    },
    {
      "start": 12.82,
      "end": 13.8,
      "text": "你错哪了"
    },
    {
      "start": 13.8,
      "end": 14.64,
      "text": "听懂没有"
    },
    {
      "start": 14.64,
      "end": 15.7,
      "text": "就是你不用说别的"
    },
    {
      "start": 15.7,
      "end": 17.34,
      "text": "AI会自己反复思考"
    },
    {
      "start": 17.34,
      "end": 18.06,
      "text": "反复琢磨"
    },
    {
      "start": 18.06,
      "end": 19.4,
      "text": "你知道最怕什么吗"
    },
    {
      "start": 19.4,
      "end": 21.48,
      "text": "最怕皇帝下场出主意"
    },
    {
      "start": 21.48,
      "end": 23.04,
      "text": "因为你一旦下场出主意"
    },
    {
      "start": 23.04,
      "end": 24.14,
      "text": "你又会被大臣发现"
    },
    {
      "start": 24.14,
      "end": 25.32,
      "text": "其实你没啥水平"
    },
    {
      "start": 25.32,
      "end": 26.7,
      "text": "这是世界上最可怕的事情"
    },
    {
      "start": 26.7,
      "end": 27.54,
      "text": "你知道吗"
    },
    {
      "start": 27.54,
      "end": 28.44,
      "text": "就是你不能出主意"
    },
    {
      "start": 28.44,
      "end": 29.34,
      "text": "你不出主意没关系"
    },
    {
      "start": 29.34,
      "end": 30.9,
      "text": "最怕人喜欢什么"
    },
    {
      "start": 30.9,
      "end": 32.16,
      "text": "下场自己干活"
    },
    {
      "start": 32.16,
      "end": 34.72,
      "text": "除非你这个人非常非常专业"
    },
    {
      "start": 34.72,
      "end": 36.44,
      "text": "就是你在自己最专业的名誉"
    },
    {
      "start": 36.44,
      "end": 38.32,
      "text": "你是可以指挥AI的"
    },
    {
      "start": 38.32,
      "end": 39.5,
      "text": "但是其他所有领域"
    },
    {
      "start": 39.5,
      "end": 40.44,
      "text": "你就最好少指挥"
    },
    {
      "start": 40.44,
      "end": 41.24,
      "text": "你越指挥越什么"
    },
    {
      "start": 41.24,
      "end": 42.02,
      "text": "越完蛋"
    },
    {
      "start": 42.02,
      "end": 44.0,
      "text": "如果你想了解更多AI的用法"
    },
    {
      "start": 44.0,
      "end": 44.78,
      "text": "评论区留言"
    },
    {
      "start": 44.78,
      "end": 46.4,
      "text": "AI 我送你一份文档"
    }
  ],

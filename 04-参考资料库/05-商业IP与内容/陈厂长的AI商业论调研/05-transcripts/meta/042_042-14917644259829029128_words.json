{
  "segments": [
    {
      "start": 0.0,
      "end": 2.4,
      "text": "日更100条绝对靠谱非常有效"
    },
    {
      "start": 2.4,
      "end": 3.62,
      "text": "但如果你打开摄像机"
    },
    {
      "start": 3.62,
      "end": 4.62,
      "text": "不知道自己要说什么"
    },
    {
      "start": 4.62,
      "end": 5.7,
      "text": "我做了一个智能体"
    },
    {
      "start": 5.7,
      "end": 6.74,
      "text": "叫日更神器"
    },
    {
      "start": 6.74,
      "end": 8.48,
      "text": "就是它可以通过短短的三个问题"
    },
    {
      "start": 8.48,
      "end": 11.02,
      "text": "就可以迅速地把你内心深处真正想表达的东西"
    },
    {
      "start": 11.02,
      "end": 11.7,
      "text": "给勾引出来"
    },
    {
      "start": 11.7,
      "end": 13.36,
      "text": "并且能够把你那些灵心的观点"
    },
    {
      "start": 13.36,
      "end": 14.38,
      "text": "碎片化的语言"
    },
    {
      "start": 14.38,
      "end": 15.52,
      "text": "不成逻辑的故事"
    },
    {
      "start": 15.52,
      "end": 17.84,
      "text": "给你整理成一片有条理有逻辑"
    },
    {
      "start": 17.84,
      "end": 20.48,
      "text": "还有深度有高度的非常优质的内容"
    },
    {
      "start": 20.48,
      "end": 22.68,
      "text": "绝对是顶流博主才能做出来的那种文案时"
    },
    {
      "start": 22.68,
      "end": 23.52,
      "text": "如果想要的"
    },
    {
      "start": 23.52,
      "end": 24.78,
      "text": "评论区留言日更神器"
    },
    {
      "start": 24.78,
      "end": 26.06,
      "text": "我直接把这个智能体发给你"
    }
  ],
